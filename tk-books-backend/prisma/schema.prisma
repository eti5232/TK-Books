generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MaterialType {
  SONG
  TEST
  REVIEW_SHEET
  TEACHER_GUIDE // מדריך למורה – חינמי להורדה
}

enum ProductKind {
  DIGITAL
  PHYSICAL
}

enum ProductCategory {
  FLASHCARDS
  SONGBOOK // שירון
  PRINTABLES
  STICKERS
  STAMPS
  OTHER
}

// זרימה: PENDING (ממתינה לתשלום) → PAID → ORDERED (הוזמנה מהספק) → SHIPPED → DELIVERED
// APPROVED ו-REJECTED נשארו בגלל תאימות למסד קיים (אישור ידני בוטל – לא בשימוש)
enum OrderStatus {
  PENDING
  APPROVED
  SHIPPED
  DELIVERED
  REJECTED
  CANCELLED
  PAID
  ORDERED
  REFUNDED
}

enum Lang {
  he
  en
}

enum ContactStatus {
  NEW
  HANDLED
}

enum EmailStatus {
  SENT
  FAILED
  SKIPPED
}

model Admin {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
}

model Book {
  id            String   @id @default(uuid())
  slug          String   @unique
  titleHe       String
  titleEn       String
  descriptionHe String   @default("")
  descriptionEn String   @default("")
  coverImageKey String?
  sortOrder     Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  pages     BookPage[]
  materials Material[]
  faqs      Faq[]
  products  Product[]
}

model BookPage {
  id         String @id @default(uuid())
  bookId     String
  pageNumber Int
  storageKey String

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([bookId, pageNumber])
}

model Material {
  id            String       @id @default(uuid())
  bookId        String
  type          MaterialType
  titleHe       String
  titleEn       String
  descriptionHe String       @default("")
  descriptionEn String       @default("")
  unit          Int?
  sortOrder     Int          @default(0)
  fileKey       String?
  mediaUrl      String?
  lyricsHe      String?
  lyricsEn      String?
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([bookId, type])
}

model Faq {
  id         String   @id @default(uuid())
  bookId     String?
  questionHe String
  questionEn String
  answerHe   String
  answerEn   String
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  book Book? @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([bookId])
}

model Product {
  id             String          @id @default(uuid())
  slug           String          @unique
  bookId         String?
  kind           ProductKind
  category       ProductCategory @default(OTHER)
  nameHe         String
  nameEn         String
  descriptionHe  String          @default("")
  descriptionEn  String          @default("")
  priceAgorot    Int
  currency       String          @default("ILS")
  digitalFileKey String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  book       Book?          @relation(fields: [bookId], references: [id], onDelete: SetNull)
  images     ProductImage[]
  orderItems OrderItem[]

  @@index([isActive, kind])
}

model ProductImage {
  id        String @id @default(uuid())
  productId String
  key       String
  altHe     String @default("")
  altEn     String @default("")
  sortOrder Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Order {
  id                  String      @id @default(uuid())
  code                String      @unique
  customerName        String
  customerEmail       String
  customerPhone       String?
  shippingAddress     Json?
  notes               String?
  status              OrderStatus @default(PENDING)
  totalAgorot         Int
  preferredLanguage   Lang        @default(he)
  adminNote           String?
  approvedAt          DateTime? // לא בשימוש (נשאר לתאימות)
  paidAt              DateTime?
  orderedAt           DateTime? // הוזמנה מהספק
  paymentRef          String? // מזהה עסקה אצל חברת הסליקה (בדמה: DEMO-...)
  trackingNumber      String? // מספר מעקב משלוח
  shippedAt           DateTime?
  deliveredAt         DateTime?
  estimatedDeliveryAt DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  items     OrderItem[]
  emailLogs EmailLog[]

  @@index([customerEmail])
  @@index([status])
}

model OrderItem {
  id              String @id @default(uuid())
  orderId         String
  productId       String
  quantity        Int
  unitPriceAgorot Int
  productNameHe   String
  productNameEn   String

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  grants  DownloadGrant[]
}

model DownloadGrant {
  id            String    @id @default(uuid())
  orderItemId   String
  token         String    @unique
  expiresAt     DateTime
  downloadCount Int       @default(0)
  maxDownloads  Int       @default(10)
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
}

model ContactMessage {
  id        String        @id @default(uuid())
  name      String
  email     String
  subject   String
  message   String
  orderCode String?
  status    ContactStatus @default(NEW)
  createdAt DateTime      @default(now())

  @@index([status])
}

model EmailLog {
  id        String      @id @default(uuid())
  orderId   String?
  to        String
  type      String
  subject   String
  status    EmailStatus
  error     String?
  createdAt DateTime    @default(now())

  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)
}
