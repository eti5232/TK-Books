# ===== העתיקי קובץ זה ל-.env והחליפי ערכים. אל תעלי את .env ל-GitHub! =====

NODE_ENV=development
PORT=3000

# חיבור למסד PostgreSQL (מקומי: npm run db:dev מפעיל מסד לפיתוח על פורט 5433)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/tkbooks

# סוד להצפנת ה-JWT. לפחות 32 תווים אקראיים. ב-Render ייווצר אוטומטית.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=8h

# כתובות מותרות לאתר ה-React (מופרדות בפסיק)
CORS_ORIGIN=http://localhost:5173
# כתובת אתר ה-React (משמשת בקישורים במיילים)
FRONTEND_URL=http://localhost:5173
# כתובת השרת הזה. ב-Render מתמלא אוטומטית אם משאירים ריק.
PUBLIC_BASE_URL=http://localhost:3000

# ===== אחסון קבצים =====
# local = תיקיית uploads/ (לפיתוח בלבד; בענן החינמי הקבצים נמחקים!)
# supabase = Supabase Storage (מומלץ לענן)
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET_PUBLIC=tk-public
SUPABASE_BUCKET_PRIVATE=tk-private

# ===== מיילים (SMTP). אם ריק – המיילים רק נרשמים ביומן ולא נשלחים =====
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="TK Books <no-reply@example.com>"
ADMIN_NOTIFY_EMAIL=owner@example.com
SUPPORT_EMAIL=support@example.com

# ===== תשלום =====
# fake = תשלום דמה (לא גובה כסף). בייצור השרת לא יעלה עם fake אלא אם מוגדר גם הדגל הבא (לבדיקות בלבד!)
PAYMENT_DRIVER=fake
# ALLOW_FAKE_PAYMENTS_IN_PRODUCTION=true

# ===== מנהלת + נתוני הדגמה =====
# בייצור חובה להגדיר את שניהם כדי ליצור את חשבון המנהלת (סיסמה חזקה!)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=TK Admin
# true = להכניס ספרים/מוצרים/הזמנות לדוגמה (בפיתוח ברירת המחדל true, בייצור false)
SEED_DEMO=

# ===== כללי עסק =====
DOWNLOAD_VALID_DAYS=3
DELIVERY_BUSINESS_DAYS=7
MAX_ITEM_QUANTITY=10
